import tkinter as tk
from tkinter import messagebox

def hasil_prediksi():
    label_hasil.config(text="Prodi Pilihan: Teknologi Informasi")

root = tk.Tk()
root.title("Aplikasi Prediksi Prodi")
root.geometry("380x450")
root.configure(padx=15, pady=15)

label_judul = tk.Label(root, text="Aplikasi Prediksi Prodi Pilihan", font=("Arial", 14, "bold"))
label_judul.grid(row=0, column=0, columnspan=2, pady=15)

entries = []
for i in range(1, 11):
    lbl = tk.Label(root, text=f"Nilai Mata Pelajaran {i}:", font=("Arial", 10))
    lbl.grid(row=i, column=0, sticky="w", padx=20, pady=3)
    
    ent = tk.Entry(root)
    ent.grid(row=i, column=1, padx=20, pady=3)
    entries.append(ent)

btn_prediksi = tk.Button(root, text="Hasil Prediksi", bg="#4CAF50", fg="white", font=("Arial", 10, "bold"), command=hasil_prediksi)
btn_prediksi.grid(row=11, column=0, columnspan=2, pady=15)

label_hasil = tk.Label(root, text="Prodi Pilihan: -", font=("Arial", 11, "bold"), fg="blue")
label_hasil.grid(row=12, column=0, columnspan=2, pady=10)

root.mainloop()